# UniSelfie environment settings
# Copy this file to .env and fill in the values. Never commit .env.

# Port the website runs on (defaults to 3022)
PORT=3022

# Set to "production" on the live server (makes the login cookie HTTPS-only)
NODE_ENV=development

# Admin panel login at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random secret that signs the login cookie (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# How long a login lasts, in hours (optional, defaults to 12)
SESSION_HOURS=12

# Where inquiries are saved (optional, defaults to data/submissions.json)
# DATA_FILE=./data/submissions.json
